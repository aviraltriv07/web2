          "step": 1000000,
          "value": 10000000,
          "unit": "kg"
        },
        {
          "name": "distance",
          "label": "Distance from Object (m)",
          "type": "range",
          "min": 100,
          "max": 10000,
          "step": 100,
          "value": 1000,
          "unit": "m"
        }
      ],
      "results": [
        {
          "label": "Time Dilation Factor",
          "unit": "",
          "formula": "1 - (2GM)/(c²r)"
